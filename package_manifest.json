{
  "_comment": "Single source of truth for all packaging (setup.py, PyInstaller specs, build_download_assets.sh, self-update manifest). Edit this, not the 4 consumers. See build/HEADLESS_BROWSER_PACKAGING.md for the per-platform frozen-deps strategy.",
  "version_source": "version.py",

  "modules": [
    "laintas_cli",
    "agent_loop",
    "tools",
    "skills",
    "mcp_client",
    "policy",
    "memory_system",
    "hooks",
    "plan_mode",
    "prompt_opt",
    "prompt_lab",
    "evolution_lab",
    "evolution_runner",
    "extension_runtime",
    "task_manager",
    "workgraph",
    "agent_persistence",
    "agent_roles",
    "workflow_engine",
    "backend_profiles",
    "trust_store",
    "paths",
    "migrate",
    "cloud_provider",
    "hwo_runner",
    "hwo_ui",
    "updater",
    "version",
    "browser_session",
    "snapshot",
    "webrtc_channel"
  ],

  "packages": [
    "agent_tools",
    "context_policy",
    "diagnostics_adapter",
    "format_adapter",
    "patch_adapter"
  ],

  "package_data": {
    "agent_tools": ["catalog.json"],
    "context_policy": ["policy.json"],
    "diagnostics_adapter": ["registry.json"],
    "format_adapter": ["registry.json"],
    "patch_adapter": []
  },

  "data_dirs": ["default_skills"],

  "extra_files": ["PROJECT.md", "SECURITY_CUSTOMIZATION.md", "requirements.txt", "setup.py"],

  "frozen_deps": {
    "linux":   ["websockets", "playwright", "aiortc", "av", "cffi"],
    "windows": ["aiortc", "av", "cffi"]
  },

  "extras_require": {
    "browser": ["websockets>=12.0", "playwright>=1.40"],
    "webrtc":  ["aiortc>=1.14"],
    "mcp":     ["mcp>=1.0"],
    "all":     ["websockets>=12.0", "playwright>=1.40", "aiortc>=1.14", "mcp>=1.0"]
  },

  "core_requires": [
    "requests>=2.28.0",
    "certifi>=2024.0.0",
    "rich>=13.0.0",
    "prompt_toolkit>=3.0.0"
  ]
}
