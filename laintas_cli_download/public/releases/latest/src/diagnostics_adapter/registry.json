{
  "version": "0.1.0",
  "description": "Shared post-edit diagnostics registry: file extension -> ordered list of native single-file CHECKER commands. The agent product runs the first checker whose binary is installed after an edit and surfaces any findings (the 'did my edit break it' feedback loop — the highest-value part of LSP for an agent, minus the JSON-RPC server complexity). Project-level type-checking (tsc/go build/cargo) is intentionally NOT here — the agent runs those via shell. `{file}` is substituted with the edited file's path. Vendored into each product; execution + file I/O stay client-side.",
  "timeout_seconds": 10,
  "max_output_chars": 2000,
  "checkers": {
    ".py": [
      { "bin": "ruff",    "cmd": ["ruff", "check", "--quiet", "--output-format", "concise", "{file}"] },
      { "bin": "pyflakes","cmd": ["pyflakes", "{file}"] },
      { "bin": "python3", "cmd": ["python3", "-m", "py_compile", "{file}"] }
    ],
    ".sh": [
      { "bin": "shellcheck", "cmd": ["shellcheck", "-f", "gcc", "{file}"] },
      { "bin": "bash",       "cmd": ["bash", "-n", "{file}"] }
    ],
    ".bash": [
      { "bin": "shellcheck", "cmd": ["shellcheck", "-f", "gcc", "{file}"] },
      { "bin": "bash",       "cmd": ["bash", "-n", "{file}"] }
    ],
    ".json": [
      { "bin": "python3", "cmd": ["python3", "-c", "import json,sys; json.load(open(sys.argv[1]))", "{file}"] }
    ],
    ".js":  [ { "bin": "node", "cmd": ["node", "--check", "{file}"] } ],
    ".cjs": [ { "bin": "node", "cmd": ["node", "--check", "{file}"] } ],
    ".mjs": [ { "bin": "node", "cmd": ["node", "--check", "{file}"] } ],
    ".go":  [ { "bin": "gofmt", "cmd": ["gofmt", "-e", "-l", "{file}"] } ],
    ".rb":  [ { "bin": "ruby", "cmd": ["ruby", "-c", "{file}"] } ],
    ".php": [ { "bin": "php", "cmd": ["php", "-l", "{file}"] } ],
    ".yaml":[ { "bin": "python3", "cmd": ["python3", "-c", "import sys,yaml; yaml.safe_load(open(sys.argv[1]))", "{file}"] } ],
    ".yml": [ { "bin": "python3", "cmd": ["python3", "-c", "import sys,yaml; yaml.safe_load(open(sys.argv[1]))", "{file}"] } ]
  }
}
